{
  "name": "sysvinit-service-generator",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "run-s lint lint:css format:check type-check test"
  },
  "devDependencies": {
    "@ivuorinen/stylelint-config": "^1.3.7",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@ivuorinen/stylelint-config@1.3.7": false
  }
}
