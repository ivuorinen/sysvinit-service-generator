{
  "name": "sysvinit-service-generator",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:css && npm run format:check && npm run type-check && npm test"
  },
  "devDependencies": {
    "@ivuorinen/stylelint-config": "^1.3.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.0.3",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "@ivuorinen/stylelint-config": false,
    "fsevents": false
  }
}
